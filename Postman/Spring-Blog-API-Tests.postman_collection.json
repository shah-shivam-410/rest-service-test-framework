								{
									"listen": "prerequest",
									"script": {
										"exec": [
											"const Allowed = {\r",
											"    Uppers: \"QWERTYUIOPASDFGHJKLZXCVBNM\",\r",
											"    Lowers: \"qwertyuiopasdfghjklzxcvbnm\",\r",
											"    Numbers: \"1234567890\",\r",
											"    Symbols: \"!@#$%^&*\"\r",
											"}\r",
											"\r",
											"const getRandomCharFromString = (str) => str.charAt(Math.floor(Math.random() * str.length))\r",
											"const generatePassword = (length = 10) => { // password will be @Param-length, default to 10, and have at least one upper, one lower, one number and one symbol\r",
											"    let pwd = \"\";\r",
											"    pwd += getRandomCharFromString(Allowed.Uppers); //pwd will have at least one upper\r",
											"    pwd += getRandomCharFromString(Allowed.Lowers); //pwd will have at least one lower\r",
											"    pwd += getRandomCharFromString(Allowed.Numbers); //pwd will have at least one number\r",
											"    pwd += getRandomCharFromString(Allowed.Symbols);//pwd will have at least one symbolo\r",
											"    for (let i = pwd.length; i < length; i++)\r",
											"        pwd += getRandomCharFromString(Object.values(Allowed).join('')); //fill the rest of the pwd with random characters\r",
											"    return pwd\r",
											"}\r",
											"\r",
											"\r",
											"var createdUsername = pm.variables.replaceIn('{{$randomUserName}}');\r",
											"var createdEmail = pm.variables.replaceIn('{{$randomEmail}}');\r",
											"var createdPassword = generatePassword(10);\r",
											"var createdAbout = pm.variables.replaceIn('{{$randomLoremText}}');\r",
											"\r",
											"console.info(createdUsername + ' : ' + createdEmail + \" : \" + createdPassword + ' : ' + createdAbout);\r",
											"\r",
											"pm.collectionVariables.set('createdUsername', createdUsername);\r",
											"pm.collectionVariables.set('createdEmail', createdEmail);\r",
											"pm.collectionVariables.set('createdPassword', createdPassword);\r",
											"pm.collectionVariables.set('createdAbout', createdAbout);\r",
											"\r",
